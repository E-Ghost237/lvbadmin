# syntax=docker/dockerfile:1

# ---- build: compile the partner portal (browser-only SPA) ----------------
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --fund=false

COPY . .
RUN npx ng build partner-portal --configuration production

# ---- runtime: static files behind nginx with SPA fallback ----------------
FROM nginx:1.27-alpine AS runtime
COPY docker/partner-portal.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/partner-portal/browser /usr/share/nginx/html
EXPOSE 80
